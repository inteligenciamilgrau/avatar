# ==============================================================
#  Avatar Voxel - configuracao
#
#      copy .env.example .env
#
#  O .env NUNCA vai para o git (ver .gitignore).
#
#  Escolha UM dos tres modos abaixo. Cada um precisa de coisas
#  diferentes - nao instale o que o seu modo nao usa.
#
#    MODO           precisa de            chave paga?
#    ------------   -------------------   -----------
#    Ollama local   Python + .venv        nao
#    Gemini Live    so a chave            sim
#    GPT-Live       so a chave            sim
#
#  Voce NAO precisa instalar ffmpeg em nenhum dos tres. O
#  Faster Whisper le o audio com PyAV, que ja traz as bibliotecas
#  do FFmpeg dentro do pacote.
# ==============================================================


# --------------------------------------------------------------
#  MODO 1 - OLLAMA LOCAL  (100% offline, sem custo)
#  microfone -> Faster Whisper -> Ollama -> voz do Windows
#
#  Este e o unico modo que usa Python. Os outros dois nao.
# --------------------------------------------------------------

# Python que roda o Faster Whisper.
# Deixe VAZIO se voce criou o .venv na pasta do projeto:
#     python -m venv .venv
#     .venv\Scripts\pip install -r requirements.txt
# So preencha se o seu Python estiver em outro lugar.
WHISPER_PYTHON=

# Token do Ollama - so se o seu servidor Ollama for remoto e pedir
# autenticacao. Para o Ollama local padrao, deixe vazio.
OLLAMA_API_KEY=


# --------------------------------------------------------------
#  MODO 2 - GEMINI LIVE  (nuvem, pago)
#  Nao usa Python, nao usa Whisper, nao usa Ollama.
#  Basta a chave: https://aistudio.google.com/apikey
# --------------------------------------------------------------

GEMINI_API_KEY=


# --------------------------------------------------------------
#  MODO 3 - GPT-LIVE / OpenAI Realtime  (nuvem, pago)
#  Tambem nao usa Python nem Whisper.
#  Chave: https://platform.openai.com/api-keys
# --------------------------------------------------------------

OPENAI_API_KEY=


# ==============================================================
#  OPCIONAIS - pode ignorar tudo daqui para baixo
# ==============================================================

# Porta do servidor local (padrao 8787).
PORT=

# Pasta com cublas64_12.dll e cudnn64_9.dll, para o Whisper usar a
# GPU NVIDIA. Normalmente NAO precisa: instalando o
# requirements-gpu.txt, o worker acha as DLLs dentro do venv.
# Preencha so se elas estiverem em outro lugar (ex: C:\CUDA\bin).
WHISPER_CUDA_DLL_DIR=

# Pasta do ffmpeg.exe. Praticamente ninguem precisa disto - veja a
# nota la em cima. Fica aqui so como valvula de escape, caso o PyAV
# nao de conta de algum formato de audio exotico.
FFMPEG_DIR=
